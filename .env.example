# Copy to .env for local (non-Docker) runs. docker-compose sets these itself.

# --- Redis / Postgres -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://orders:orders@localhost:5432/orders

# --- Telemetry --------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Chaos engineering ------------------------------------------------------
# Probability (0.0-1.0) that a consumer step raises a transient error, used to
# exercise retry + DLQ behaviour. Leave at 0.0 for normal operation.
FAIL_RATE=0.0

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
